{
  "name": "nurbekjummayev/laravel-country",
  "description": "ISO 3166-1 country classifier for Laravel: migration, seed data and Eloquent model with uz/oz/ru/en names",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "country", "iso-3166", "classifier", "reference-data", "uzbekistan"],
  "authors": [
    { "name": "Nurbek Jummayev", "email": "jummayevnurbek279@gmail.com", "role": "Developer" }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "illuminate/support": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/console": "^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.13",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Nurbekjummayev\\LaravelCountry\\": "src/",
      "Nurbekjummayev\\LaravelCountry\\Database\\": "database/"
    }
  },
  "autoload-dev": {
    "psr-4": { "Nurbekjummayev\\LaravelCountry\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["Nurbekjummayev\\LaravelCountry\\CountryServiceProvider"]
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "lint": "vendor/bin/pint --test",
    "lint:fix": "vendor/bin/pint"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": { "pestphp/pest-plugin": true }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
